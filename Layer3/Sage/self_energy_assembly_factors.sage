#!/usr/bin/env sage
# --------------------------------------------------------------------------
# SOURCE (primary): P. E. Williams, LA-8370-MS (LASL, 1980), eqs (96)-(104)
#   (free energy of a charged particle, prediction P3). Assembly factors are
#   this script's own analysis, not the source's.
# --------------------------------------------------------------------------
#
# self_energy_assembly_factors.sage                [A]  (assertion-driven)
#
# THE FIXED-POTENTIAL PROBLEM IN P3, AND WHY R0 SURVIVES IT.
#
# Both terms of Williams' free energy are obtained by integrating dq with the
# potentials held at their FINAL values:
#
#   Coulomb : (dG/dq) uses the field of the full charge e, integrated at fixed R,
#             giving  e^2/(4 pi eps0 R).   Proper assembly (potential growing with
#             the charge already present) gives 1/2 of that for surface charging,
#             or 3/5 for charge spread uniformly through the ball.
#   V-field : integrated with V0 taken independent of q. But if V0 is generated by
#             the charge (V0 = a0 K_g phi_E, cf. v0_source_law.sage) then V0 ~ q and
#             that integral is likewise halved.
#
# Introduce the two assembly factors explicitly,
#
#   G(R) = -alpha e^2/(4 pi eps0 R) + beta 3 e m k/(4 pi a0 R^4) + G0,
#
# with (alpha,beta) = (1,1) for Williams. The point of this script:
#
#   R0^3 = 12 m k eps0 (beta/alpha)/(e a0)      -- depends ONLY on the RATIO
#   G_min - G0 = -(3 alpha/4) e^2/(4 pi eps0 R0) -- depends on alpha
#
# So when both integrals carry the SAME correction the errors CANCEL EXACTLY in
# the radius, which is the quantity P3 is anchored on and from which k is inferred;
# only the DEPTH of the minimum is affected (halved). The radius result, and hence
# the estimate of k, is therefore robust to the defect; the energy is not.
#
# CLAIMS:
#   (1) Stationarity and stability for general (alpha,beta): R0^3 = 12 m k eps0 b/(a e a0),
#       and G''(R0) > 0.
#   (2) G_min - G0 = -(3 alpha/4) e^2/(4 pi eps0 R0): depth scales with alpha alone.
#   (3) R0 is invariant under alpha -> c*alpha, beta -> c*beta (the errors cancel).
#   (4) Both-halved (1/2,1/2): R0 EXACTLY unchanged, depth exactly halved.
#   (5) Uniform-ball Coulomb with halved V-field (3/5,1/2): R0 falls by only 5.9%,
#       so the inferred k rises by 20% -- inside the quoted 2-6e-20 V range.
#   (6) Correcting the Coulomb term ALONE (as a naive fix would) moves R0 by 18.6%,
#       which is why the two integrals must be corrected together.
# ==========================================================================

from sage.all import *

def ok(label, cond):
    cond = bool(cond)
    print("  [%s] %s" % ("PASS" if cond else "FAIL", label))
    assert cond, "ASSERTION FAILED: " + label

print("=" * 70)
print("P3 ASSEMBLY FACTORS -- the radius is robust, the depth is not")
print("=" * 70)

R, e_, m_, k_, a0_, eps0_ = var('R e m k a0 eps0', domain='positive')
al, be = var('alpha beta', domain='positive')

G = -al*e_**2/(4*pi*eps0_*R) + be*3*e_*m_*k_/(4*pi*a0_*R**4)

# --- (1) stationary radius, general (alpha,beta) ---------------------------
print("\n[1] Stationary radius for general assembly factors")
dG = diff(G, R)
R0 = (12*m_*k_*eps0_*be/(al*e_*a0_))**(1/3)
ok("G'(R0) = 0  with R0^3 = 12 m k eps0 (beta/alpha)/(e a0)",
   dG.subs(R=R0).simplify_full() == 0)
d2 = diff(G, R, 2).subs(R=R0).simplify_full()
ok("G''(R0) > 0 (a genuine minimum for all positive alpha,beta)",
   bool(d2.subs({e_:1, m_:1, k_:1, a0_:1, eps0_:1, al:1, be:1}) > 0))

# --- (2) depth of the minimum --------------------------------------------
print("\n[2] Depth of the minimum scales with alpha alone")
Gmin = G.subs(R=R0).simplify_full()
expected = -(3*al/4)*e_**2/(4*pi*eps0_*R0)
ok("G_min - G0 = -(3 alpha/4) e^2/(4 pi eps0 R0)",
   (Gmin - expected).simplify_full() == 0)

# --- (3) the errors cancel in R0 -----------------------------------------
print("\n[3] R0 is invariant under a COMMON rescaling of both factors")
cc = var('c', domain='positive')
R0_scaled = R0.subs({al: cc*al, be: cc*be}).simplify_full()
ok("R0(c*alpha, c*beta) = R0(alpha, beta): the two errors cancel exactly",
   (R0_scaled - R0).simplify_full() == 0)
ok("...but the depth does NOT: G_min(c*alpha) = c * G_min(alpha)",
   (expected.subs({al: cc*al, be: cc*be}) - cc*expected).simplify_full() == 0)

# --- (4)-(6) the three corrections, numerically --------------------------
print("\n[4-6] Numerical effect on R0 and on the inferred k")
sub0 = {e_: 1.602176634e-19, m_: 1.67262192e-27, a0_: 3.65e7,
        eps0_: 8.8541878128e-12, k_: 5.69e-20}
def R0n(a, b):
    return float(R0.subs(sub0).subs({al: a, be: b}))
base = R0n(1, 1)
print("    %-46s %9s %8s %9s" % ("(alpha, beta)", "R0 (fm)", "R0/base", "k needed"))
rows = [("Williams: both at final potential (1, 1)", 1.0, 1.0),
        ("both properly assembled, surface (1/2, 1/2)", 0.5, 0.5),
        ("Coulomb uniform ball + V halved (3/5, 1/2)", 0.6, 0.5),
        ("NAIVE: Coulomb alone corrected (3/5, 1)", 0.6, 1.0)]
res = {}
for lab, a, b in rows:
    r = R0n(a, b)
    kneed = 5.69e-20*(base/r)**3          # k that restores the base radius
    res[(a, b)] = r
    print("    %-46s %9.4f %8.4f %9.2e" % (lab, r*1e15, r/base, kneed))

ok("(1/2,1/2) leaves R0 EXACTLY unchanged",
   abs(res[(0.5, 0.5)]/base - 1) < 1e-12)
ok("(1/2,1/2) halves the depth exactly",
   abs(float((expected.subs(sub0).subs({al:0.5,be:0.5})
              / expected.subs(sub0).subs({al:1,be:1})).n()) - 0.5) < 1e-12)
ok("(3/5,1/2) moves R0 by less than 6%",
   abs(res[(0.6, 0.5)]/base - 1) < 0.06)
ok("correcting the Coulomb term ALONE moves R0 by ~18.6% (why both are needed)",
   0.18 < abs(res[(0.6, 1.0)]/base - 1) < 0.19)

print("\n  NET: the fixed-potential defect is real and affects BOTH integrals of")
print("  Williams' free energy. Because R0 depends only on the ratio beta/alpha,")
print("  correcting them together leaves the stationary radius unchanged (exactly,")
print("  if both are halved; within 6% if the Coulomb term is treated as a uniform")
print("  ball). The radius law, and the estimate of k inferred from it, therefore")
print("  survive. What does NOT survive is the DEPTH: G_min scales with alpha and")
print("  is halved, so no comparison of G_min with measured nuclear energies should")
print("  be made on the uncorrected expression. Correcting the Coulomb term alone")
print("  would move R0 by 18.6% and is the wrong fix.")
print("\n" + "=" * 70)
print("self_energy_assembly_factors COMPLETE.")
print("=" * 70)
